{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lsdcapital-web",
  "account_id": "28e7c1fba549ce3a5b6828c5f600fd10",
  "compatibility_date": "2026-05-13",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": false,
  "preview_urls": false,
  // No "routes" here on purpose. Terraform owns the lsd.capital custom domain
  // (lsdcapital/cloudflare in the lsdcapital/tf repo); Wrangler only publishes
  // code. Declaring the hostname in both places makes every deploy re-assert it
  // and fight Terraform for ownership.
}
